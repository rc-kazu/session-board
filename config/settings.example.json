{
  "_comment": "session-board の動作設定。~/.config/session-board/settings.json に置く (無くてもよい。書いた項目だけ既定値を上書きする)。各項目の説明は README の「設定」を参照。terminal は cmux / wezterm / orca / none。editor はコマンド名か絶対パス (cursor / code / zed など)。",
  "port": 8765,
  "window_days": 21,
  "stale_days": 3,
  "facts_refresh_seconds": 60,
  "gh_cache_seconds": 300,
  "llm_enabled": true,
  "llm_on_startup": true,
  "llm_model": "sonnet",
  "llm_claude_path": "",
  "llm_concurrency": 3,
  "llm_timeout_seconds": 120,
  "llm_input_chars": 5000,
  "llm_resummarize_min_new_user_msgs": 3,
  "llm_resummarize_min_interval_minutes": 60,
  "report_input_chars": 12000,
  "report_model": "sonnet",
  "report_timeout_seconds": 300,
  "digest_enabled": true,
  "digest_model": "sonnet",
  "digest_timeout_seconds": 300,
  "digest_input_chars": 30000,
  "digest_lint_rounds": 2,
  "yomiyasu_dir": "",
  "column_wide_min_items": 8,
  "terminal": "cmux",
  "editor": "cursor",
  "editor_args": []
}
